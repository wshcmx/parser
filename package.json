{
  "name": "@wshcmx/parser",
  "version": "0.1.0",
  "description": "Реализованный на Node.js парсер скриптов диалекта SPXML",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wshcmx/parser.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "~6.0.3"
  }
}